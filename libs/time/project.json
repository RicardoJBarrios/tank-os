{
  "name": "time",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/time/src",
  "prefix": "tankos",
  "projectType": "library",
  "tags": ["scope:shared", "scope:tankos", "type:time-core"],
  "targets": {
    "browser-test": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "build",
        { "target": "build", "projects": ["time-luxon"] }
      ],
      "options": { "command": "node libs/time/tests/browser/check.mjs" }
    },
    "build": {
      "dependsOn": [],
      "executor": "@nx/angular:ng-packagr-lite",
      "outputs": ["{workspaceRoot}/dist/libs/time"],
      "options": {
        "project": "libs/time/ng-package.json",
        "tsConfig": "libs/time/tsconfig.lib.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "libs/time/tsconfig.lib.prod.json"
        }
      },
      "defaultConfiguration": "production"
    },
    "nx-release-publish": {
      "options": {
        "packageRoot": "dist/{projectRoot}"
      }
    },
    "test": {
      "outputs": [
        "{projectRoot}/{options.coverage.reportsDirectory}",
        "{workspaceRoot}/coverage/libs/time"
      ],
      "options": {
        "coverage": true,
        "coverage.reportsDirectory": "../../coverage/libs/time"
      }
    }
  }
}

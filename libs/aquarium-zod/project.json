{
  "name": "aquarium-zod",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/aquarium-zod/src",
  "projectType": "library",
  "tags": ["scope:tankos", "type:adapter"],
  "targets": {
    "build": {
      "executor": "@nx/angular:ng-packagr-lite",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "defaultConfiguration": "production",
      "options": {
        "project": "libs/aquarium-zod/ng-package.json",
        "tsConfig": "libs/aquarium-zod/tsconfig.lib.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "libs/aquarium-zod/tsconfig.lib.prod.json"
        },
        "development": {}
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "outputs": ["{workspaceRoot}/coverage/libs/aquarium-zod"],
      "options": {
        "coverage": false,
        "coverage.reportsDirectory": "../../coverage/libs/aquarium-zod"
      }
    }
  }
}
